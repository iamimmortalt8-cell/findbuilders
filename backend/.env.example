# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# Frontend URLs (comma-separated for CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3002

# Backend Configuration
PORT=3001
NODE_ENV=development

# Email / Resend Configuration
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=FindBuilders <hello@findbuilders.app>
APP_URL=https://findbuilders.app