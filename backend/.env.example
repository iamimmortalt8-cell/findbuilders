# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# Frontend URLs (comma-separated for CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3002

# OAuth callback origin (optional). Overrides FRONTEND_URL[0] for signInWithOAuth redirectTo.
# Production: https://findbuilders.pages.dev (custom domain not connected yet)
# Local: omit to use FRONTEND_URL[0] (http://localhost:3000)
# OAUTH_REDIRECT_ORIGIN=https://findbuilders.pages.dev

# Backend Configuration
PORT=3001
NODE_ENV=development

# AI API Configuration
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your-ai-api-key-here
AI_API_MODEL=gpt-4o-mini

# Email / Resend Configuration
# Master switch for the whole email subsystem. STRICT boolean: ONLY the exact
# value "true" enables email; everything else (false, FALSE, 0, empty, missing)
# disables it. Default when missing: DISABLED (fail-safe — no Resend client is
# constructed, no email_events rows are written, triggers silently no-op).
# Email is currently disabled because no sending domain is verified in Resend.
EMAIL_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=FindBuilders <onboarding@resend.dev>
# Optional Reply-To header (leave unset until a verified domain exists).
# EMAIL_REPLY_TO=hello@your-verified-domain.com
APP_URL=https://findbuilders.pages.dev
# NOTE: findbuilders.app is NOT live/verified — the email code ignores it and
# falls back to https://findbuilders.pages.dev for links, and the logo always
# uses https://findbuilders.pages.dev/findbuilderslogo.png (absolute HTTPS).

# Email test mode — ONLY for Resend testing while the account can only deliver
# to the owner's email. When true, Resend delivery is redirected to
# EMAIL_TEST_RECIPIENT; event keys, templates, and email_events still use the
# original recipient. Leave false once a Resend domain is verified.
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=
